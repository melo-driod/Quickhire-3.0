PORT=5000
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/quickhire?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
APP_URL=http://localhost:5000

# Paystack: leave blank to disable payments during development
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CURRENCY=NGN

# Optional production CORS origin
CORS_ORIGIN=http://localhost:5000

# Optional when scaling Socket.IO across multiple server instances
REDIS_URL=

# Payout security
PAYOUT_ACCOUNT_COOLDOWN_HOURS=24
PAYOUT_DAILY_LIMIT_NGN=500000
